---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

// Maakt automatisch één pagina per design
export async function getStaticPaths() {
  const designs = await getCollection('designs', ({ data }) => !data.draft);
  return designs.map((design) => ({ params: { slug: design.id }, props: { design } }));
}

const { design } = Astro.props;
const { title, year, client, role, tags, thumbnail, color } = design.data;
const { Content } = await render(design);
---

<Base title={`${title} — Robbe Verslype`}>
  <nav class="back">
    <a href="/">← Terug naar de hoop</a>
  </nav>

  <article>
    <header class="hero" style={`--accent: ${color}`}>
      <div class="hero-text">
        <h1>{title}</h1>
        <dl>
          <div><dt>Jaar</dt><dd>{year}</dd></div>
          {client && <div><dt>Klant</dt><dd>{client}</dd></div>}
          {role && <div><dt>Rol</dt><dd>{role}</dd></div>}
          {tags.length > 0 && <div><dt>Tags</dt><dd>{tags.join(', ')}</dd></div>}
        </dl>
      </div>
      <Image
        src={thumbnail}
        alt={title}
        width={900}
        class="hero-img"
        style={`view-transition-name: thumb-${design.id}`}
      />
    </header>

    <div class="case">
      <Content />
    </div>
  </article>

  <footer class="end">
    <a href="/">← Terug naar de hoop</a>
  </footer>
</Base>

<style>
  .back {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
  }
  .back a,
  .end a {
    display: inline-block;
    padding: 0.5rem 0.9rem;
    background: var(--ink);
    color: var(--bg);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: end;
    padding: 5rem 1rem 2.5rem;
    background: var(--accent);
  }
  @media (min-width: 800px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      padding: 6rem 3rem 3rem;
      min-height: 80vh;
    }
  }
  .hero-text {
    background: var(--bg);
    padding: 1.5rem;
    border-radius: 6px;
  }
  .hero h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.25rem, 7vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 0;
  }
  dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  dd {
    margin: 0.15rem 0 0;
  }
  .hero-img {
    width: 100%;
    max-height: 75vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.45);
  }

  .case {
    max-width: 44rem;
    margin: 0 auto;
    padding: 3rem 1rem 2rem;
    font-size: 1.125rem;
    line-height: 1.65;
  }
  .case :global(h2) {
    margin: 3rem 0 0.75rem;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
  }
  .case :global(img) {
    width: 100%;
    margin: 2rem 0;
    border-radius: 4px;
  }
  @media (min-width: 1000px) {
    /* Foto's in de case mogen breder zijn dan de tekst */
    .case :global(p:has(> img)) {
      margin-inline: -8rem;
    }
  }

  .end {
    padding: 2rem 1rem 4rem;
    text-align: center;
  }
</style>
