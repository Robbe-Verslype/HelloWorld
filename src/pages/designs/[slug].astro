---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Blocks from '../../components/Blocks.astro';
import UbnGenerator from '../../components/UbnGenerator.astro';
import { getDesigns, isMedia, type Design } from '../../lib/designs';

// Maakt automatisch één pagina per mapje
export function getStaticPaths() {
  return getDesigns().map((design) => ({ params: { slug: design.slug }, props: { design } }));
}

const { design } = Astro.props as { design: Design };
const { title, year, client, role, tags, thumbnail, hero, color, blocks, sections, gallery, extraClips } = design;
// Dropdowns blijven bij elkaar; hun foto's komen er samen onder
// De foto bovenaan (hero) niet nog eens in de lijst
const introBlocks = blocks.filter((b) => !(b.type === 'photo' && b.photo.name === hero.name));
// Us By Night: bovenaan een live gegenereerd logo in plaats van een vaste foto
const liveLogo = design.slug === 'us-by-night';
const sectionPhotos = sections.flatMap((s) =>
  s.blocks.filter((b) => isMedia(b) && !(b.type === 'photo' && b.photo.name === hero.name)),
);
---

<Base title={`${title} — Robbe Verslype`}>
  <nav class="back">
    <a href="/">← Terug naar de projecten</a>
  </nav>

  <article>
    <header class="hero" style={`--accent: ${color}`}>
      <div class="hero-text">
        <h1>{title}</h1>
        <dl>
          {year && <div><dt>Jaar</dt><dd>{year}</dd></div>}
          {client && <div><dt>Klant</dt><dd>{client}</dd></div>}
          {role && <div><dt>Rol</dt><dd>{role}</dd></div>}
          {tags.length > 0 && <div><dt>Tags</dt><dd>{tags.join(', ')}</dd></div>}
        </dl>
      </div>
      {
        liveLogo ? (
          <div class="live-logo">
            <Image
              src={hero.image}
              alt="Een gegenereerd UBN-logo"
              width={Math.min(1200, hero.image.width)}
              class="hero-img live-logo-img"
              id="live-logo-img"
              style={`view-transition-name: thumb-${design.slug}`}
            />
          </div>
        ) : (
          <Image
            src={hero.image}
            alt={title}
            width={Math.min(1200, hero.image.width)}
            class="hero-img"
            style={`view-transition-name: thumb-${design.slug}`}
          />
        )
      }
    </header>

    <div class="case">
      {/* Links: tekst en dropdowns */}
      <div class="case-text">
        {introBlocks.length > 0 && <Blocks blocks={introBlocks} />}

        {
          sections.length > 0 && (
            <div class="sections">
              {sections.map((section) => {
                const text = section.blocks.filter((b) => !isMedia(b));
                return (
                  <div class="section">
                    {text.length > 0 ? (
                      <details name="case-sections">
                        <summary>
                          <span>{section.title}</span>
                          <span class="icon" aria-hidden="true" />
                        </summary>
                        <div class="section-body">
                          <Blocks blocks={text} />
                        </div>
                      </details>
                    ) : (
                      <h2 class="section-title">{section.title}</h2>
                    )}
                  </div>
                );
              })}
            </div>
          )
        }
      </div>

      {/* Rechts (op gsm eronder): alle foto's, altijd zichtbaar */}
      {
        (sectionPhotos.length > 0 || gallery.length > 0 || extraClips.length > 0) && (
          <div class="case-photos">
            {liveLogo && <UbnGenerator />}
            {liveLogo && (
              <div class="live-sheet">
                <img id="live-sheet-img" class="photo" alt="10 willekeurig gegenereerde UBN-logo's" width="2000" height="660" />
                <div class="live-logo-bar">
                  <button type="button" id="live-sheet-new">Genereer 10 nieuwe logo's</button>
                </div>
              </div>
            )}
            <Blocks blocks={sectionPhotos} />
            <Blocks blocks={extraClips} />
            {gallery.map((photo) => (
              <Image src={photo.image} alt="" width={Math.min(1800, photo.image.width)} class="photo" />
            ))}
          </div>
        )
      }
    </div>
  </article>

  <footer class="end">
    <a href="/">← Terug naar de projecten</a>
  </footer>
</Base>

<script>
  import { randomLogoSheet, randomLogoCanvas, screenGrainPx } from '../../scripts/ubn-logo';

  // Us By Night: logo bovenaan op schermresolutie tekenen (zelfde korrel als de generator).
  // Kom je van de homepage, dan is het hetzelfde logo als de thumbnail.
  const heroImg = document.getElementById('live-logo-img') as HTMLImageElement | null;
  if (heroImg) {
    let cfg;
    try { cfg = JSON.parse(sessionStorage.getItem('ubn-logo') || 'null'); } catch {}
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const w = Math.max(300, Math.round((heroImg.clientWidth || 600) * dpr));
    try {
      const canvas = randomLogoCanvas(w, Math.round((w * 3) / 4), '#000000', { cfg: cfg && typeof cfg.shape === 'number' ? cfg : undefined, grainPx: screenGrainPx() });
      heroImg.removeAttribute('srcset');
      heroImg.src = canvas.toDataURL('image/webp', 0.92);
    } catch {}
  }

  // Us By Night: 10 willekeurig gegenereerde logo's, met een knop voor een nieuwe reeks
  const sheetImg = document.getElementById('live-sheet-img') as HTMLImageElement | null;
  const sheetBtn = document.getElementById('live-sheet-new') as HTMLButtonElement | null;
  function newSheet() {
    if (!sheetImg) return;
    if (sheetBtn) sheetBtn.disabled = true;
    setTimeout(() => {
      try {
        const dpr = Math.min(2, window.devicePixelRatio || 1);
        const cellW = Math.max(120, Math.round(((sheetImg.clientWidth || 680) * dpr) / 5));
        const cellH = Math.round((cellW * 330) / 400);
        sheetImg.src = randomLogoSheet(5, 2, cellW, cellH, '#ffffff', screenGrainPx()).toDataURL('image/webp', 0.92);
      } finally {
        if (sheetBtn) sheetBtn.disabled = false;
      }
    }, 20);
  }
  if (sheetImg) {
    newSheet();
    sheetBtn?.addEventListener('click', newSheet);
  }

  // Altijd bovenaan de case beginnen, ook als de browser een oude scrollpositie onthoudt
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  const toTop = () => {
    if (!location.hash) window.scrollTo(0, 0);
  };
  toTop();
  addEventListener('pageshow', toTop);

  // Maar één dropdown tegelijk open (ook in browsers zonder <details name>)
  const all = document.querySelectorAll<HTMLDetailsElement>('.section details');
  for (const d of all) {
    d.addEventListener('toggle', () => {
      if (d.open) for (const other of all) if (other !== d) other.open = false;
    });
  }
</script>

<style>
  .back {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
  }
  .back a,
  .end a {
    display: inline-block;
    padding: 0.5rem 0.9rem;
    background: var(--ink);
    color: var(--bg);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: end;
    padding: 5rem 1rem 2.5rem;
    background: var(--accent);
  }
  @media (min-width: 800px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      padding: 6rem 3rem 3rem;
      min-height: 80vh;
    }
  }
  .hero-text {
    background: var(--bg);
    padding: 1.5rem;
    border-radius: 6px;
  }
  .hero h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.25rem, 7vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 0;
  }
  dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  dd {
    margin: 0.15rem 0 0;
  }
  .hero-img {
    width: 100%;
    height: auto;
    max-height: 75vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.45);
  }

  .live-logo {
    display: grid;
    justify-items: center;
  }
  .live-sheet {
    display: grid;
    gap: 0.9rem;
    margin: 0 0 0.5rem;
  }
  .live-sheet img {
    width: 100%;
    height: auto;
    aspect-ratio: 2000 / 660;
    background: #fff;
  }
  .live-logo-img {
    background: #000;
    aspect-ratio: 4 / 3;
  }
  .live-logo-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    align-items: center;
    justify-content: center;
  }
  .live-logo-bar button {
    padding: 0.6rem 1.1rem;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font: 500 0.95rem var(--font);
    cursor: pointer;
    box-shadow: 0 8px 24px -8px rgb(0 0 0 / 0.4);
  }
  .live-logo-bar button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .live-logo-bar a {
    color: var(--ink);
    font: 500 0.95rem var(--font);
  }
  .live-logo-bar button:focus-visible,
  .live-logo-bar a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  /* Twee kolommen: links de dropdowns, rechts de foto's. Op gsm onder elkaar. */
  .case {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 44rem;
    margin: 0 auto;
    padding: 3rem 1rem 1rem;
    font-size: 1.125rem;
    line-height: 1.65;
  }
  .case-text,
  .case-photos {
    min-width: 0;
  }
  @media (min-width: 900px) {
    .case {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 3rem;
      max-width: 82rem;
      padding: 4rem 3rem 1rem;
      align-items: start;
    }
    /* De dropdowns blijven in beeld terwijl je langs de foto's scrolt */
    .case-text {
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }
  }
  .case :global(h3) {
    margin: 2.25rem 0 0.5rem;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }
  .case :global(p) {
    margin: 0 0 1rem;
  }

  /* De drie dropdowns */
  .sections {
    border-top: 1px solid rgb(0 0 0 / 0.15);
  }
  .section {
    border-bottom: 1px solid rgb(0 0 0 / 0.15);
  }
  .section summary,
  .section-title {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.4rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    cursor: pointer;
    list-style: none;
  }
  .section summary::-webkit-details-marker {
    display: none;
  }
  .section-title {
    cursor: default;
  }
  .section summary:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }
  /* Plus dat een min wordt als de dropdown open is */
  .icon {
    position: relative;
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
  }
  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 2px;
    margin-top: -1px;
    background: currentColor;
    transition: transform 0.2s;
  }
  .icon::after {
    transform: rotate(90deg);
  }
  .section details[open] .icon::after {
    transform: rotate(0deg);
  }
  .section-body {
    padding-bottom: 1.5rem;
  }
  .section-body > :global(:first-child) {
    margin-top: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .section details[open] .section-body {
      animation: open 0.25s ease-out;
    }
  }
  @keyframes open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .case-photos {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .case :global(.photo) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border-radius: 4px;
  }

  /* Bijschrift verschijnt pas bij hover (of tikken op gsm), zodat de layout niet verandert */
  .case :global(.figure) {
    position: relative;
    margin: 0;
    outline: none;
  }
  .case :global(figcaption) {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.6rem 0.8rem;
    border-radius: 6px;
    background: rgb(20 20 20 / 0.85);
    color: #fff;
    font-size: 0.85rem;
    line-height: 1.4;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s, transform 0.2s;
    pointer-events: none;
  }
  .case :global(.figure:hover figcaption),
  .case :global(.figure:focus-visible figcaption),
  .case :global(.figure:focus figcaption) {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .case :global(figcaption) {
      transition: none;
    }
  }

  .end {
    padding: 2rem 1rem 4rem;
    text-align: center;
  }
</style>
