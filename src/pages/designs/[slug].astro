---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getDesigns, type Design } from '../../lib/designs';

// Maakt automatisch één pagina per mapje
export function getStaticPaths() {
  return getDesigns().map((design) => ({ params: { slug: design.slug }, props: { design } }));
}

const { design } = Astro.props as { design: Design };
const { title, year, client, role, tags, thumbnail, color, blocks, gallery } = design;
---

<Base title={`${title} — Robbe Verslype`}>
  <nav class="back">
    <a href="/">← Terug naar de hoop</a>
  </nav>

  <article>
    <header class="hero" style={`--accent: ${color}`}>
      <div class="hero-text">
        <h1>{title}</h1>
        <dl>
          {year && <div><dt>Jaar</dt><dd>{year}</dd></div>}
          {client && <div><dt>Klant</dt><dd>{client}</dd></div>}
          {role && <div><dt>Rol</dt><dd>{role}</dd></div>}
          {tags.length > 0 && <div><dt>Tags</dt><dd>{tags.join(', ')}</dd></div>}
        </dl>
      </div>
      <Image
        src={thumbnail.image}
        alt={title}
        width={Math.min(1200, thumbnail.image.width)}
        class="hero-img"
        style={`view-transition-name: thumb-${design.slug}`}
      />
    </header>

    <div class="case">
      {
        blocks.map((block) =>
          block.type === 'heading' ? (
            <h2>{block.text}</h2>
          ) : block.type === 'photo' ? (
            <Image
              src={block.photo.image}
              alt=""
              width={Math.min(1800, block.photo.image.width)}
              class="photo"
            />
          ) : (
            <p>
              {block.lines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </p>
          ),
        )
      }
    </div>

    {
      gallery.length > 0 && (
        <div class="gallery">
          {gallery.map((photo) => (
            <Image
              src={photo.image}
              alt=""
              width={Math.min(1800, photo.image.width)}
              class="photo"
            />
          ))}
        </div>
      )
    }
  </article>

  <footer class="end">
    <a href="/">← Terug naar de hoop</a>
  </footer>
</Base>

<style>
  .back {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
  }
  .back a,
  .end a {
    display: inline-block;
    padding: 0.5rem 0.9rem;
    background: var(--ink);
    color: var(--bg);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: end;
    padding: 5rem 1rem 2.5rem;
    background: var(--accent);
  }
  @media (min-width: 800px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      padding: 6rem 3rem 3rem;
      min-height: 80vh;
    }
  }
  .hero-text {
    background: var(--bg);
    padding: 1.5rem;
    border-radius: 6px;
  }
  .hero h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.25rem, 7vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 0;
  }
  dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  dd {
    margin: 0.15rem 0 0;
  }
  .hero-img {
    width: 100%;
    height: auto;
    max-height: 75vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.45);
  }

  .case {
    max-width: 44rem;
    margin: 0 auto;
    padding: 3rem 1rem 1rem;
    font-size: 1.125rem;
    line-height: 1.65;
  }
  .case h2 {
    margin: 3rem 0 0.75rem;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
  }
  .photo {
    width: 100%;
    height: auto;
    margin: 2rem 0;
    border-radius: 4px;
  }
  @media (min-width: 1000px) {
    /* Foto's in de tekst mogen breder zijn dan de tekst */
    .case .photo {
      width: calc(100% + 16rem);
      max-width: none;
      margin-inline: -8rem;
    }
  }

  .gallery {
    max-width: 60rem;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .end {
    padding: 2rem 1rem 4rem;
    text-align: center;
  }
</style>
