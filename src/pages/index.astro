---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getDesigns } from '../lib/designs';

const designs = getDesigns();

// Kleinere, geoptimaliseerde versies van de thumbnails maken
const items = await Promise.all(
  designs.map(async (d) => {
    const thumb = d.thumbnail.image;
    const img = await getImage({ src: thumb, width: Math.min(640, thumb.width), format: 'webp' });
    return {
      slug: d.slug,
      title: d.title,
      year: d.year,
      src: img.src,
      ratio: thumb.width / thumb.height,
    };
  }),
);
---

<Base title="Robbe Verslype — Designs">
  <header class="intro">
    <h1>Robbe Verslype</h1>
    <p>Een hoop nieuwe designs. Sleep ze rond, klik om de case te lezen.</p>
  </header>

  <main class="pile" id="pile" aria-label="Designs">
    {/* De kamer: achterwand, vloer, zijwanden en plafond in perspectief, met licht en schaduw */}
    <svg class="room" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <radialGradient id="wall-light" cx="50%" cy="8%" r="75%">
          <stop offset="0" stop-color="#4a4a4e" />
          <stop offset="0.55" stop-color="#333336" />
          <stop offset="1" stop-color="#242426" />
        </radialGradient>
        <linearGradient id="wall-foot" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0.7" stop-color="#000" stop-opacity="0" />
          <stop offset="1" stop-color="#000" stop-opacity="0.45" />
        </linearGradient>
        <linearGradient id="floor" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#121214" />
          <stop offset="0.3" stop-color="#26262a" />
          <stop offset="1" stop-color="#36363a" />
        </linearGradient>
        <radialGradient id="floor-light" cx="50%" cy="35%" r="50%">
          <stop offset="0" stop-color="#fff" stop-opacity="0.07" />
          <stop offset="1" stop-color="#fff" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="side-left" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#1f1f21" />
          <stop offset="1" stop-color="#151517" />
        </linearGradient>
        <linearGradient id="side-right" x1="1" y1="0" x2="0" y2="0">
          <stop offset="0" stop-color="#1f1f21" />
          <stop offset="1" stop-color="#151517" />
        </linearGradient>
        <linearGradient id="ceiling" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#1a1a1c" />
          <stop offset="1" stop-color="#111113" />
        </linearGradient>
      </defs>
      <rect x="0" y="0" width="100" height="100" fill="url(#wall-light)" />
      <rect x="7" y="6" width="86" height="72" fill="url(#wall-foot)" />
      <polygon points="0,0 100,0 93,6 7,6" fill="url(#ceiling)" />
      <polygon points="0,0 7,6 7,78 0,100" fill="url(#side-left)" />
      <polygon points="100,0 93,6 93,78 100,100" fill="url(#side-right)" />
      <polygon points="7,78 93,78 100,100 0,100" fill="url(#floor)" />
      <polygon points="7,78 93,78 100,100 0,100" fill="url(#floor-light)" />
      {/* Hoeklijnen waar de vlakken elkaar raken */}
      <g stroke="#000" stroke-opacity="0.35" stroke-width="0.25" vector-effect="non-scaling-stroke" fill="none">
        <polyline points="0,0 7,6 7,78 0,100" />
        <polyline points="100,0 93,6 93,78 100,100" />
        <line x1="7" y1="6" x2="93" y2="6" />
        <line x1="7" y1="78" x2="93" y2="78" />
      </g>
    </svg>
    <div class="vignette" aria-hidden="true"></div>
    {
      items.map((item) => (
        <a
          class="thumb"
          href={`/designs/${item.slug}/`}
          data-ratio={item.ratio}
          draggable="false"
          style={`--vt: thumb-${item.slug}`}
        >
          <img src={item.src} alt={item.title} draggable="false" loading="eager" />
          <span class="label">
            {item.title} <em>{item.year}</em>
          </span>
        </a>
      ))
    }
  </main>

  <button class="bomb" id="bomb" type="button" aria-label="Laat de bom afgaan">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <circle cx="10" cy="14" r="7" fill="currentColor"></circle>
      <path d="M14.5 8.5 17 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      <path d="M18 2.5v2M21.5 6h-2M20.5 3.5l-1.3 1.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    </svg>
    <span>Boem</span>
    <span class="pile-count" data-pile hidden></span>
  </button>

  <noscript>
    <style>
      .pile { display: flex; flex-wrap: wrap; gap: 1rem; padding: 6rem 1rem 1rem; height: auto; }
      .thumb { position: static; width: 220px; visibility: visible; }
      .bomb { display: none; }
    </style>
  </noscript>
</Base>

<style>
  .intro {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 2;
    padding: 1.25rem 1rem;
    max-width: 32rem;
    pointer-events: none;
  }
  .intro h1 {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  /* Op smalle schermen ruimte laten voor de Contact-knop rechtsboven */
  @media (max-width: 640px) {
    .intro {
      padding-right: 8rem;
    }
  }
  .intro p {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* De homepage is een donkere kamer: kleuren omdraaien zodat tekst en knoppen leesbaar blijven */
  :global(html:has(#pile)) {
    --bg: #1e1e20;
    --ink: #ece9e2;
    --muted: #a19e96;
  }

  .room,
  .vignette {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* Donkere randen, alsof het licht van boven in het midden valt */
  .vignette {
    background: radial-gradient(ellipse 80% 70% at 50% 35%, transparent 55%, rgb(0 0 0 / 0.45) 100%);
  }

  .pile {
    background: #1e1e20;
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }

  .bomb {
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 100000;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.1rem 0.7rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font: 500 0.95rem var(--font);
    cursor: pointer;
    box-shadow: 0 8px 24px -8px rgb(0 0 0 / 0.4);
    transition: transform 0.15s;
  }
  .bomb:hover {
    transform: scale(1.05) rotate(-3deg);
  }
  .bomb:active {
    transform: scale(0.95);
  }
  .bomb:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .pile-count {
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }

  /* Kleine schok van het scherm als de bom afgaat */
  .pile.boom {
    animation: shake 0.4s ease-out;
  }
  @keyframes shake {
    0%, 100% { transform: none; }
    20% { transform: translate(-6px, 4px); }
    40% { transform: translate(5px, -3px); }
    60% { transform: translate(-3px, 2px); }
    80% { transform: translate(2px, -1px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pile.boom { animation: none; }
  }

  .thumb {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    /* Pas zichtbaar zodra de physics hem op een positie zet */
    visibility: hidden;
    touch-action: none;
    cursor: grab;
    will-change: transform;
    -webkit-tap-highlight-color: transparent;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
    /* Schaduw valt naar beneden op de vloer, licht komt van boven */
    box-shadow:
      0 2px 3px rgb(0 0 0 / 0.35),
      0 18px 28px -10px rgb(0 0 0 / 0.7);
    transition: box-shadow 0.2s;
    view-transition-name: var(--vt);
  }
  .thumb:hover img,
  .thumb:focus-visible img {
    box-shadow:
      0 3px 5px rgb(0 0 0 / 0.4),
      0 26px 40px -12px rgb(0 0 0 / 0.8);
  }
  .thumb:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }
  .thumb.dragging {
    cursor: grabbing;
  }

  .label {
    position: absolute;
    left: 0;
    bottom: calc(100% + 6px);
    padding: 0.25rem 0.5rem;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.8rem;
    white-space: nowrap;
    border-radius: 3px;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.15s,
      transform 0.15s;
    pointer-events: none;
  }
  .label em {
    font-style: normal;
    opacity: 0.6;
  }
  .thumb:hover .label,
  .thumb:focus-visible .label {
    opacity: 1;
    transform: none;
  }
  .thumb.dragging .label {
    opacity: 0;
  }
</style>

<script>
  import { initGravityPile } from '../scripts/gravity';

  const pile = document.getElementById('pile');
  if (pile) initGravityPile(pile, document.querySelector<HTMLButtonElement>('#bomb'));
</script>
