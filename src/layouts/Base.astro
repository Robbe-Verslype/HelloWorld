---
import Contact from '../components/Contact.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Een hoop nieuwe designs.' } = Astro.props;

// Halyard Display komt van Adobe Fonts. Vul hier de ID van je web project in
// (fonts.adobe.com → Web Projects → de code in https://use.typekit.net/XXXXXXX.css).
const ADOBE_FONTS_ID = 'ira3tvv';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {ADOBE_FONTS_ID && <link rel="stylesheet" href={`https://use.typekit.net/${ADOBE_FONTS_ID}.css`} />}
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <Contact />
  </body>
</html>

<style is:global>
  :root {
    --bg: #f1efe9;
    --ink: #1d1d1b;
    --muted: #6f6c64;
    --font: 'Inter Tight', system-ui, sans-serif;
    /* Titels: Halyard Display (Adobe Fonts), anders Inter Tight */
    --font-display: 'halyard-display', 'Inter Tight', system-ui, sans-serif;
  }

  /* Vloeiende overgang tussen thumbnail en case-pagina (Chrome/Safari) */
  @view-transition {
    navigation: auto;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font);
    -webkit-font-smoothing: antialiased;
  }

  h1 {
    font-family: var(--font-display);
  }

  a {
    color: inherit;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
