---
// Afterra-postergenerator, ingebouwd in de Afterra-case.
// Je typt een stad; de wijken en deelgemeenten worden de hubs (via OpenStreetMap), en de poster wordt
// getekend volgens het systeem: één blok dat zich bij elke hub in twee splitst, het noorden van boven
// naar beneden en het zuiden van onder naar boven.
---

<section class="ap" aria-labelledby="ap-title">
  <div class="ap-head">
    <h3 id="ap-title">Maak je eigen Afterra-poster</h3>
    <p>Typ een stad. De wijken en deelgemeenten worden de hubs, en het systeem tekent er de poster van.</p>
  </div>

  <form class="ap-form" id="ap-form">
    <label class="ap-visually-hidden" for="ap-city">Stad</label>
    <input id="ap-city" name="city" type="text" placeholder="Bv. Mechelen" autocomplete="off" required />
    <button type="submit" class="ap-btn ap-primary">Maak poster</button>
  </form>
  <div class="ap-examples" aria-label="Voorbeelden">
    {['Brugge', 'Mechelen', 'Kortrijk', 'Aalst', 'Brussel', 'Rotterdam'].map((c) => (
      <button type="button" class="ap-chip" data-city={c}>{c}</button>
    ))}
  </div>

  <p class="ap-status" id="ap-status" aria-live="polite"></p>

  <div class="ap-stage">
    <canvas id="ap-canvas" width="1190" height="1684" aria-label="Voorbeeld van de poster"></canvas>
  </div>

  <div class="ap-actions">
    <label class="ap-check"><input type="checkbox" id="ap-hubs" /> Toon de hubs</label>
    <button type="button" class="ap-btn" id="ap-download" disabled>Download poster (PNG)</button>
  </div>
  <p class="ap-hublist" id="ap-hublist"></p>
  <p class="ap-credit">Wijken en deelgemeenten: © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>-bijdragers</p>
</section>

<style>
  .ap {
    display: grid;
    gap: 0.8rem;
    padding: 1.25rem;
    border-radius: 8px;
    background: #111110;
    color: #fbf6e2;
  }
  .ap-head h3 {
    margin: 0;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }
  .ap-head p {
    margin: 0.25rem 0 0;
    color: rgb(251 246 226 / 0.7);
    font-size: 0.92rem;
  }
  .ap-form {
    display: flex;
    gap: 0.5rem;
  }
  .ap-form input {
    flex: 1;
    min-width: 0;
    padding: 0.65rem 0.9rem;
    border: 1px solid rgb(251 246 226 / 0.25);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
  }
  .ap-form input::placeholder {
    color: rgb(251 246 226 / 0.45);
  }
  .ap-form input:focus-visible,
  .ap-btn:focus-visible,
  .ap-chip:focus-visible {
    outline: 2px solid #fbf6e2;
    outline-offset: 2px;
  }
  .ap-btn {
    padding: 0.65rem 1.1rem;
    border: 1px solid #fbf6e2;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: 500 0.92rem var(--font);
    cursor: pointer;
    white-space: nowrap;
  }
  .ap-primary {
    background: #fbf6e2;
    color: #111110;
  }
  .ap-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .ap-examples {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .ap-chip {
    padding: 0.3rem 0.7rem;
    border: 1px solid rgb(251 246 226 / 0.25);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: 0.82rem var(--font);
    cursor: pointer;
  }
  .ap-chip:hover {
    border-color: #fbf6e2;
  }
  .ap-status {
    margin: 0;
    min-height: 1.4em;
    font-size: 0.85rem;
    color: rgb(251 246 226 / 0.75);
  }
  .ap-stage canvas {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
    background: #fbf6e2;
  }
  .ap-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .ap-check {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    font-size: 0.88rem;
    cursor: pointer;
  }
  .ap-hublist {
    margin: 0;
    font-size: 0.78rem;
    color: rgb(251 246 226 / 0.6);
  }
  .ap-credit {
    margin: 0;
    font-size: 0.72rem;
    color: rgb(251 246 226 / 0.45);
  }
  .ap-credit a {
    color: inherit;
  }
  .ap-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (max-width: 480px) {
    .ap-form {
      flex-direction: column;
    }
  }
</style>

<script>
  type Hub = { name: string; lat: number; lon: number; city?: boolean };
  type Placed = Hub & { x: number; y: number };

  const BLACK = '#111110';
  const CREAM = '#fbf6e2';
  const W = 1190;
  const H = 1684;
  const MAX_HUBS = 10; // plus de city hub
  const FONT = "'Inter Tight', 'Helvetica Neue', Arial, sans-serif";

  const form = document.getElementById('ap-form') as HTMLFormElement | null;
  const input = document.getElementById('ap-city') as HTMLInputElement;
  const status = document.getElementById('ap-status')!;
  const canvas = document.getElementById('ap-canvas') as HTMLCanvasElement;
  const showHubs = document.getElementById('ap-hubs') as HTMLInputElement;
  const download = document.getElementById('ap-download') as HTMLButtonElement;
  const hubList = document.getElementById('ap-hublist')!;

  let current: { city: string; hubs: Hub[] } | null = null;

  // ---------- Hubs opzoeken via OpenStreetMap ----------

  async function fetchJson(url: string, ms = 15000) {
    const ctrl = new AbortController();
    const t = setTimeout(() => ctrl.abort(), ms);
    try {
      const res = await fetch(url, { signal: ctrl.signal, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      return await res.json();
    } finally {
      clearTimeout(t);
    }
  }

  const PLACE_RANK: Record<string, number> = { suburb: 0, town: 0, village: 1, quarter: 2, neighbourhood: 3 };

  async function findHubs(query: string): Promise<{ city: string; hubs: Hub[] }> {
    const found = await fetchJson(
      'https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&accept-language=nl&featureType=settlement&q=' +
        encodeURIComponent(query),
    );
    if (!found?.length) throw new Error('notfound');
    const place = found[0];
    const city = String(place.name || query);
    const center: Hub = { name: `${city} · city hub`, lat: +place.lat, lon: +place.lon, city: true };

    const placeFilter = 'node["place"~"^(suburb|quarter|village|town|neighbourhood)$"]';
    const q =
      place.osm_type === 'relation'
        ? `[out:json][timeout:20];area(id:${3600000000 + Number(place.osm_id)})->.a;${placeFilter}(area.a);out body 300;`
        : `[out:json][timeout:20];${placeFilter}(around:7000,${center.lat},${center.lon});out body 300;`;
    const data = await fetchJson('https://overpass-api.de/api/interpreter?data=' + encodeURIComponent(q), 25000);

    const seen = new Set([city.toLowerCase()]);
    const candidates = (data?.elements ?? [])
      .map((e: any) => ({
        name: String(e.tags?.['name:nl'] || e.tags?.name || ''),
        lat: e.lat,
        lon: e.lon,
        rank: PLACE_RANK[e.tags?.place] ?? 4,
      }))
      .filter((c: any) => c.name && !seen.has(c.name.toLowerCase()) && seen.add(c.name.toLowerCase()))
      .sort((a: any, b: any) => a.rank - b.rank);

    // Liefst grote wijken en deelgemeenten; kleinere buurten enkel als er te weinig zijn
    let pool = candidates;
    for (let r = 0; r <= 3; r++) {
      const upTo = candidates.filter((c: any) => c.rank <= r);
      if (upTo.length >= 6) {
        pool = upTo;
        break;
      }
    }
    const hubs = spreadOut(pool, center, MAX_HUBS);
    if (hubs.length < 3) throw new Error('fewhubs');
    return { city, hubs: [center, ...hubs] };
  }

  /** Kies punten die mooi verspreid liggen, zodat de hubs niet allemaal op één hoopje zitten. */
  function spreadOut(pool: Hub[], center: Hub, n: number): Hub[] {
    const k = Math.cos((center.lat * Math.PI) / 180);
    const d = (a: Hub, b: Hub) => Math.hypot((a.lon - b.lon) * k, a.lat - b.lat);
    const chosen: Hub[] = [];
    const left = [...pool];
    const ref = [center];
    while (chosen.length < n && left.length) {
      let best = 0;
      let bestD = -1;
      left.forEach((p, i) => {
        const md = Math.min(...[...ref, ...chosen].map((q) => d(p, q)));
        if (md > bestD) {
          bestD = md;
          best = i;
        }
      });
      chosen.push(left.splice(best, 1)[0]);
    }
    return chosen;
  }

  /** Als er geen kaartgegevens zijn: hubs op een vaste, willekeurige plek (altijd dezelfde per stad). */
  function fallbackHubs(city: string): Hub[] {
    let seed = 0;
    for (const ch of city.toLowerCase()) seed = (seed * 31 + ch.charCodeAt(0)) >>> 0;
    const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
    const hubs: Hub[] = [{ name: `${city} · city hub`, lat: 0, lon: 0, city: true }];
    for (let i = 0; i < MAX_HUBS; i++) {
      const a = rnd() * Math.PI * 2;
      const r = 0.25 + rnd() * 0.75;
      hubs.push({ name: `Hub ${i + 1}`, lat: Math.sin(a) * r, lon: Math.cos(a) * r * 1.2 });
    }
    return hubs;
  }

  // ---------- De poster tekenen ----------

  function place(hubs: Hub[]): Placed[] {
    const lats = hubs.map((h) => h.lat);
    const lons = hubs.map((h) => h.lon);
    const [minLat, maxLat] = [Math.min(...lats), Math.max(...lats)];
    const [minLon, maxLon] = [Math.min(...lons), Math.max(...lons)];
    // Noord bovenaan, zuid onderaan, west naar oost van links naar rechts, in de echte verhoudingen van de kaart
    const top = H * 0.2;
    const bottom = H * 0.88;
    const left = W * 0.06;
    const right = W * 0.94;
    const k = Math.cos((((minLat + maxLat) / 2) * Math.PI) / 180) || 1;
    const spanX = (maxLon - minLon) * k || 1e-6;
    const spanY = maxLat - minLat || 1e-6;
    const scale = Math.min((right - left) / spanX, (bottom - top) / spanY);
    const offX = left + ((right - left) - spanX * scale) / 2;
    const offY = top + ((bottom - top) - spanY * scale) / 2;
    return hubs
      .map((h) => ({
        ...h,
        x: offX + (h.lon - minLon) * k * scale,
        y: offY + (maxLat - h.lat) * scale,
      }))
      .sort((a, b) => a.y - b.y);
  }

  type Block = { x0: number; x1: number; dark: boolean };
  /** Kleinste blok, zoals in de originele posters: smallere blokken splitsen niet meer verder. */
  const MIN_SPLIT = W * 0.05; // een blok splitst enkel als het minstens 5% van de posterbreedte is
  const MIN_PART = W * 0.015; // een splitsing op de hub mag geen reepje smaller dan 1,5% maken
  /**
   * Elke rij: elk blok splitst in twee, op de hub als die erin ligt, anders in het midden.
   * Het linkse deel krijgt de eerste kleur, het rechtse de tweede. Een te smal blok loopt gewoon door.
   */
  function split(blocks: Block[], hubX: number, leftDark: boolean): Block[] {
    const out: Block[] = [];
    for (const b of blocks) {
      if (b.x1 - b.x0 < MIN_SPLIT) {
        out.push(b);
        continue;
      }
      const onHub = hubX - b.x0 >= MIN_PART && b.x1 - hubX >= MIN_PART;
      const at = onHub ? hubX : (b.x0 + b.x1) / 2;
      out.push({ x0: b.x0, x1: at, dark: leftDark }, { x0: at, x1: b.x1, dark: !leftDark });
    }
    return out;
  }

  /** Het blokkenpatroon: noord van boven naar beneden, zuid van onder naar boven. */
  function drawPattern(ctx: CanvasRenderingContext2D, pts: Placed[]) {
    const nNorth = Math.ceil(pts.length / 2);
    const north = pts.slice(0, nNorth);
    const south = pts.slice(nNorth);
    const seam = south.length ? (north[north.length - 1].y + south[0].y) / 2 : H * 0.88;
    const fill = (b: Block, y0: number, y1: number) => {
      ctx.fillStyle = b.dark ? BLACK : CREAM;
      ctx.fillRect(Math.floor(b.x0), Math.floor(y0), Math.ceil(b.x1 - b.x0) + 1, Math.ceil(y1 - y0) + 1);
    };

    ctx.fillStyle = CREAM;
    ctx.fillRect(0, 0, W, H);

    // Boven: één volledig zwart blok tot de eerste hub; daarna links zwart, rechts crème
    let blocks: Block[] = [{ x0: 0, x1: W, dark: true }];
    fill(blocks[0], 0, north[0].y);
    north.forEach((hub, i) => {
      blocks = split(blocks, hub.x, true);
      const y1 = i + 1 < north.length ? north[i + 1].y : seam;
      blocks.forEach((b) => fill(b, hub.y, y1));
    });

    // Onder: één volledig crème blok vanaf de laatste hub; daarna omgekeerd: links crème, rechts zwart
    blocks = [{ x0: 0, x1: W, dark: false }];
    const up = [...south].reverse();
    up.forEach((hub, i) => {
      blocks = split(blocks, hub.x, false);
      const y0 = i + 1 < up.length ? up[i + 1].y : seam;
      blocks.forEach((b) => fill(b, y0, hub.y));
    });
  }

  /**
   * Waar AFTERRA komt: altijd crème, in het eerste grote aaneengesloten zwarte vlak (dat van bovenaan),
   * in een hoek waar een crème blok begint. Zoals op de originele posters, ongeveer op 40% van de hoogte.
   */
  function labelSpot(pts: Placed[], tw: number, th: number) {
    const c = document.createElement('canvas');
    c.width = W;
    c.height = H;
    const cx = c.getContext('2d', { willReadFrequently: true })!;
    drawPattern(cx, pts);
    const data = cx.getImageData(0, 0, W, H).data;
    const G = 4; // raster van 4 px
    const cols = Math.floor(W / G);
    const rows = Math.floor(H / G);
    const dark = new Uint8Array(cols * rows);
    for (let r = 0; r < rows; r++)
      for (let q = 0; q < cols; q++) dark[r * cols + q] = data[((r * G + 2) * W + q * G + 2) * 4] < 128 ? 1 : 0;

    // Het zwarte vlak dat aan de bovenrand vastzit
    const comp = new Uint8Array(cols * rows);
    const stack: number[] = [];
    for (let q = 0; q < cols; q++) if (dark[q]) (comp[q] = 1), stack.push(q);
    while (stack.length) {
      const i = stack.pop()!;
      const r = Math.floor(i / cols);
      const q = i % cols;
      for (const [rr, qq] of [[r + 1, q], [r - 1, q], [r, q + 1], [r, q - 1]]) {
        if (rr < 0 || rr >= rows || qq < 0 || qq >= cols) continue;
        const j = rr * cols + qq;
        if (dark[j] && !comp[j]) (comp[j] = 1), stack.push(j);
      }
    }
    const inComp = (x: number, y: number) => {
      const q = Math.floor(x / G);
      const r = Math.floor(y / G);
      return q >= 0 && q < cols && r >= 0 && r < rows && comp[r * cols + q] === 1;
    };
    const fits = (x: number, y: number) => {
      const m = 6;
      for (let yy = y - th - m; yy <= y + m; yy += G)
        for (let xx = x - m; xx <= x + tw + m; xx += G) if (!inComp(xx, yy)) return false;
      return true;
    };

    // Bovenranden van crème blokken die tegen dit zwarte vlak liggen: hun hoeken zijn de kandidaten
    const gap = W * 0.01;
    const target = H * 0.42;
    let best: { x: number; y: number } | null = null;
    let bestScore = Infinity;
    for (let r = 1; r < rows; r++) {
      let q = 0;
      while (q < cols) {
        if (!dark[r * cols + q] && comp[(r - 1) * cols + q]) {
          const q0 = q;
          while (q < cols && !dark[r * cols + q] && comp[(r - 1) * cols + q]) q++;
          const top = r * G;
          const y = top - gap;
          if (y - th < H * 0.16) continue;
          const xs = q0 * G;
          const xe = q * G;
          // Linkerhoek (tekst links uitgelijnd met het crème blok) of rechterhoek
          // Begint het crème blok aan de rand van de poster, dan houdt de tekst de gewone marge aan
          const pad = W * 0.028;
          for (const [x, pref] of [[Math.max(xs, pad), 0], [Math.min(xe, W - pad) - tw, 1]] as const) {
            if (x < pad - 1 || x + tw > W - pad + 1) continue;
            const score = Math.abs(y - target) + pref * 20;
            if (score < bestScore && fits(x, y)) {
              best = { x, y };
              bestScore = score;
            }
          }
        } else q++;
      }
    }
    return best ?? { x: W * 0.028, y: pts[0].y - gap };
  }

  function draw(ctx: CanvasRenderingContext2D, city: string, hubs: Hub[], withHubs: boolean) {
    const pts = place(hubs);
    drawPattern(ctx, pts);

    // Tekst
    const pad = W * 0.028;
    ctx.textBaseline = 'alphabetic';
    ctx.fillStyle = CREAM;
    ctx.font = `500 ${W * 0.052}px ${FONT}`;
    ['The new ecosystem for', 'communication after', 'the blackout.'].forEach((line, i) => {
      ctx.fillText(line, pad, pad + W * 0.046 + i * W * 0.05);
    });

    // AFTERRA: altijd crème, in de hoek van een crème blok in het eerste grote zwarte vlak
    ctx.font = `700 ${W * 0.026}px ${FONT}`;
    const tw = ctx.measureText('AFTERRA').width;
    const spot = labelSpot(pts, tw, W * 0.02);
    ctx.fillStyle = CREAM;
    ctx.fillText('AFTERRA', spot.x, spot.y);

    // Onderaan: stad en uitnodiging
    ctx.fillStyle = BLACK;
    ctx.font = `700 ${W * 0.062}px ${FONT}`;
    ctx.fillText(city.toUpperCase(), pad, H - pad);
    ctx.font = `700 ${W * 0.0125}px ${FONT}`;
    ctx.textAlign = 'right';
    ['Learn the full system', 'EVERY FRIDAY at 20:00', `City hub ${city}`].forEach((line, i) => {
      ctx.fillText(line, W - pad, H - pad - (2 - i) * W * 0.0155);
    });
    ctx.textAlign = 'left';

    // Optioneel: de hubs tonen, zoals op de hubkaart
    if (withHubs) {
      ctx.font = `500 ${W * 0.016}px ${FONT}`;
      for (const p of pts) {
        ctx.setLineDash([6, 6]);
        ctx.strokeStyle = 'rgba(128,128,128,0.8)';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(0, p.y);
        ctx.lineTo(W, p.y);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = BLACK;
        ctx.beginPath();
        ctx.arc(p.x, p.y, W * 0.011, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = CREAM;
        ctx.beginPath();
        ctx.arc(p.x, p.y, W * 0.006, 0, Math.PI * 2);
        ctx.fill();
        const label = p.name;
        const lw = ctx.measureText(label).width + 12;
        const lx = p.x + lw + 24 > W ? p.x - lw - 16 : p.x + 16;
        ctx.fillStyle = BLACK;
        ctx.fillRect(lx, p.y - W * 0.014, lw, W * 0.024);
        ctx.fillStyle = CREAM;
        ctx.fillText(label, lx + 6, p.y + W * 0.005);
      }
    }
  }

  function render() {
    if (!current) return;
    const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
    draw(ctx, current.city, current.hubs, showHubs.checked);
  }

  async function make(query: string) {
    query = query.trim();
    if (!query) return;
    input.value = query;
    status.textContent = `Hubs van ${query} opzoeken…`;
    download.disabled = true;
    await document.fonts?.load?.(`700 20px 'Inter Tight'`).catch(() => {});
    try {
      current = await findHubs(query);
      status.textContent = `${current.hubs.length} hubs gevonden in ${current.city}.`;
      hubList.textContent = 'Hubs: ' + current.hubs.map((h) => h.name).join(', ');
    } catch (err) {
      const city = query.charAt(0).toUpperCase() + query.slice(1);
      current = { city, hubs: fallbackHubs(city) };
      status.textContent =
        (err as Error)?.message === 'notfound'
          ? `${query} werd niet gevonden op de kaart. Dit is een poster met verzonnen hubs.`
          : `De wijken van ${query} konden niet geladen worden. Dit is een poster met verzonnen hubs.`;
      hubList.textContent = '';
    }
    render();
    download.disabled = false;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    make(input.value);
  });
  document.querySelectorAll<HTMLButtonElement>('.ap-chip').forEach((b) => b.addEventListener('click', () => make(b.dataset.city!)));
  showHubs?.addEventListener('change', render);

  download?.addEventListener('click', () => {
    if (!current) return;
    // Exporteren op dubbele resolutie
    const out = document.createElement('canvas');
    out.width = W * 2;
    out.height = H * 2;
    const ctx = out.getContext('2d', { willReadFrequently: true })!;
    ctx.scale(2, 2);
    draw(ctx, current.city, current.hubs, showHubs.checked);
    out.toBlob((blob) => {
      if (!blob) return;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `afterra-poster-${current!.city.toLowerCase().replace(/[^a-z0-9]+/g, '-')}.png`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    }, 'image/png');
  });

  // Meteen een voorbeeld tonen (Antwerpen, met de hubs van de echte poster), zonder iets op te zoeken
  const ANTWERPEN: Hub[] = [
    { name: 'Permeke · city hub', lat: 51.2195, lon: 4.4285, city: true },
    { name: 'Berendrecht-Zandvliet-Lillo', lat: 51.335, lon: 4.315 },
    { name: 'Ekeren', lat: 51.28, lon: 4.43 },
    { name: 'Merksem', lat: 51.245, lon: 4.448 },
    { name: 'Linkeroever', lat: 51.222, lon: 4.385 },
    { name: 'Deurne', lat: 51.216, lon: 4.47 },
    { name: 'Borgerhout', lat: 51.211, lon: 4.442 },
