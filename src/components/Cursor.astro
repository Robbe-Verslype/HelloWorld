---
// Eigen cursor: een ronde stip die de muis volgt (rond, net als het heatmap-effect) en elastisch
// uitrekt als je snel beweegt.
// Boven een thumbnail of iets klikbaars wordt hij als een magneet naar dat element getrokken
// en legt hij zich er als vier hoekjes rond, zoals een snijkader.
// Alleen op toestellen met een muis; op gsm en tablet verandert er niets.
---

<div class="cursor" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

<style>
  .cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 2147483000;
    pointer-events: none;
    width: 14px;
    height: 14px;
    background: #fff;
    border-radius: 50%;
    /* Keert de kleuren eronder om: zwart op de lichte achtergrond, licht op donkere foto's */
    mix-blend-mode: difference;
    opacity: 0;
    transition:
      opacity 0.2s,
      background-color 0.2s,
      border-radius 0.2s;
  }
  .cursor.on {
    opacity: 1;
  }
  .cursor.snap {
    background-color: transparent;
    border-radius: 0;
  }
  .cursor i {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid #fff;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .cursor.snap i {
    opacity: 1;
  }
  .cursor i:nth-child(1) {
    left: -2px;
    top: -2px;
    border-left-width: 2px;
    border-top-width: 2px;
  }
  .cursor i:nth-child(2) {
    right: -2px;
    top: -2px;
    border-right-width: 2px;
    border-top-width: 2px;
  }
  .cursor i:nth-child(3) {
    left: -2px;
    bottom: -2px;
    border-left-width: 2px;
    border-bottom-width: 2px;
  }
  .cursor i:nth-child(4) {
    right: -2px;
    bottom: -2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
  }

  /* De gewone cursor verbergen, alleen als de eigen cursor actief is */
  :global(html.custom-cursor),
  :global(html.custom-cursor *) {
    cursor: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor,
    .cursor i {
      transition: none;
    }
  }
</style>

<script>
  const cursor = document.querySelector<HTMLElement>('.cursor');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (cursor && finePointer) {
    document.documentElement.classList.add('custom-cursor');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /** Waar de cursor zich rond legt. */
    const TARGETS = '.thumb, a, button, summary, [role="button"], label, select';
    const DOT = 14;
    const PAD = 8;

    let mx = -100;
    let my = -100;
    let target: HTMLElement | null = null;
    // Huidige (vloeiende) positie, grootte en hoek
    const cur = { x: -100, y: -100, w: DOT, h: DOT, a: 0, s: 1 };
    // Snelheid van de muis, voor het uitrekken
    let lastX = -100;
    let lastY = -100;
    let vx = 0;
    let vy = 0;

    addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        mx = e.clientX;
        my = e.clientY;
        cursor.classList.add('on');
      },
      { passive: true },
    );
    document.addEventListener('pointerleave', () => cursor.classList.remove('on'));
    addEventListener('blur', () => cursor.classList.remove('on'));

    /** Hoek waaronder een element gedraaid staat (de thumbnails liggen schuin op de hoop). */
    function angleOf(el: HTMLElement) {
      const t = getComputedStyle(el).transform;
      if (!t || t === 'none') return 0;
      const m = t.match(/matrix\(([^)]+)\)/);
      if (!m) return 0;
      const [a, b] = m[1].split(',').map(Number);
      return Math.atan2(b, a);
    }

    // Tijdens het slepen van een thumbnail blijft de cursor rond die thumbnail hangen
    let dragging = false;
    addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') dragging = !!target?.matches('.thumb');
    });
    addEventListener('pointerup', () => (dragging = false));
    addEventListener('pointercancel', () => (dragging = false));

    function frame() {
      // Opnieuw kijken wat er onder de muis ligt: thumbnails bewegen ook zonder dat de muis beweegt
      if (!dragging && mx >= 0) {
        target = document.elementFromPoint(mx, my)?.closest<HTMLElement>(TARGETS) ?? null;
      }
      let x = mx;
      let y = my;
      let w = DOT;
      let h = DOT;
      // Snelheid en richting van de muis
      vx += (mx - lastX - vx) * 0.3;
      vy += (my - lastY - vy) * 0.3;
      lastX = mx;
      lastY = my;
      const speed = Math.hypot(vx, vy);
      // De stip rekt uit in de bewegingsrichting; stilstaand blijft hij rond
      let a = speed > 0.6 ? Math.atan2(vy, vx) : cur.a;
      let stretch = reduce ? 1 : 1 + Math.min(speed / 18, 1.4);
      const snapping = !!target && target.isConnected;
      if (snapping) {
        const r = target!.getBoundingClientRect();
        // Middelpunt van het element, en zijn echte (niet-gedraaide) maat
        x = r.left + r.width / 2;
        y = r.top + r.height / 2;
        w = target!.offsetWidth + PAD * 2;
        h = target!.offsetHeight + PAD * 2;
        a = angleOf(target!);
        stretch = 1;
      }
      cursor!.classList.toggle('snap', snapping);

      const k = reduce ? 1 : snapping ? 0.25 : 0.35;
      cur.x += (x - cur.x) * k;
      cur.y += (y - cur.y) * k;
      cur.w += (w - cur.w) * k;
      cur.h += (h - cur.h) * k;
      // Kortste weg naar de nieuwe hoek
      let da = a - cur.a;
      da = Math.atan2(Math.sin(da), Math.cos(da));
      cur.a += da * (snapping ? k : 0.5);
      cur.s += (stretch - cur.s) * 0.35;

      cursor!.style.width = `${cur.w}px`;
      cursor!.style.height = `${cur.h}px`;
      cursor!.style.transform = `translate(${cur.x - cur.w / 2}px, ${cur.y - cur.h / 2}px) rotate(${cur.a}rad) scale(${cur.s}, ${1 / Math.sqrt(cur.s)})`;
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }
</script>
