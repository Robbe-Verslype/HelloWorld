---
// Heatmap-achtergrond, nagebouwd naar de mousemove-demo van heatmap.js (patrick-wied.at/static/heatmapjs).
// Elke beweging van de muis of je vinger voegt een datapunt toe. De plek waar je het vaakst kwam is het
// warmst, de rest kleurt in verhouding mee. Na een tijdje zonder beweging vervaagt een plek weer. Het canvas ligt achter alle inhoud,
// dus thumbnails, foto's en mockups blijven onaangeroerd.
---

<canvas class="heat" aria-hidden="true"></canvas>
<div class="heat-glass" aria-hidden="true"></div>

<style>
  .heat {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    /* Melkglas: het spoor zit als het ware achter een melkwitte ruit */
    filter: blur(26px);
  }
  .heat-glass {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: rgb(255 255 255 / 0.28);
  }
</style>

<script>
  // Zelfde vorm als de demo van heatmap.js, maar in zwart en grijs
  const RADIUS = 50;
  const BLUR = 0.9;
  const MAX_OPACITY = 0.6;
  /** Een plek blijft zo lang volledig staan na de laatste keer dat je er kwam (ms)... */
  const HOLD = 1500;
  /** ...en vervaagt daarna in zoveel ms. */
  const FADE = 3000;
  /** Rekenresolutie: half zo groot rekenen houdt het vlot, het beeld is toch zacht. */
  const SCALE = 0.5;
  /** Twee grijzen: lichtgrijs voor het spoor, een donkerder grijs waar je blijft hangen. */
  const GRADIENT: [number, string][] = [
    [0.25, 'rgb(190,190,190)'],
    [0.55, 'rgb(185,185,185)'],
    [0.85, 'rgb(90,90,90)'],
    [1, 'rgb(70,70,70)'],
  ];

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.heat');

  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    // Schaduwcanvas: hier wordt enkel de "warmte" (alfa) getekend, daarna ingekleurd
    const shadow = document.createElement('canvas');
    const sctx = shadow.getContext('2d', { willReadFrequently: true })!;

    // Palet van 256 kleuren
    const pal = document.createElement('canvas');
    pal.width = 256;
    pal.height = 1;
    const pctx = pal.getContext('2d')!;
    const grad = pctx.createLinearGradient(0, 0, 256, 1);
    for (const [stop, color] of GRADIENT) grad.addColorStop(stop, color);
    pctx.fillStyle = grad;
    pctx.fillRect(0, 0, 256, 1);
    const palette = pctx.getImageData(0, 0, 256, 1).data;

    // Eén punt: zachte cirkel, zoals heatmap.js die tekent
    const R = Math.round(RADIUS * SCALE);
    const tpl = document.createElement('canvas');
    tpl.width = tpl.height = R * 2;
    const tctx = tpl.getContext('2d')!;
    const tg = tctx.createRadialGradient(R, R, R * (1 - BLUR), R, R, R);
    tg.addColorStop(0, 'rgba(0,0,0,1)');
    tg.addColorStop(1, 'rgba(0,0,0,0)');
    tctx.fillStyle = tg;
    tctx.fillRect(0, 0, R * 2, R * 2);

    // Datastore: per pixel hoe vaak hij geraakt werd en wanneer voor het laatst
    const store = new Map<number, { x: number; y: number; value: number; time: number }>();
    let running = false;

    /** Hoeveel van een punt nog over is: eerst volledig, daarna lineair weg. */
    function life(age: number) {
      return age < HOLD ? 1 : Math.max(0, 1 - (age - HOLD) / FADE);
    }

    function render(now: number) {
      const w = shadow.width;
      const h = shadow.height;
      sctx.clearRect(0, 0, w, h);
      // Het maximum bepaalt de kleuren: het warmste punt is rood
      let max = 1;
      for (const [key, p] of store) {
        const v = p.value * life(now - p.time);
        if (v <= 0) store.delete(key);
        else if (v > max) max = v;
      }
      for (const p of store.values()) {
        const a = (p.value * life(now - p.time)) / max;
        sctx.globalAlpha = a < 0.01 ? 0.01 : a;
        sctx.drawImage(tpl, p.x - R, p.y - R);
      }
      // Inkleuren met het palet
      const img = sctx.getImageData(0, 0, w, h);
      const d = img.data;
      const maxA = MAX_OPACITY * 255;
      for (let i = 3; i < d.length; i += 4) {
        const a = d[i];
        if (!a) continue;
        const o = a * 4;
        d[i - 3] = palette[o];
        d[i - 2] = palette[o + 1];
        d[i - 1] = palette[o + 2];
        d[i] = a < maxA ? a : maxA;
      }
      ctx.putImageData(img, 0, 0);
      maskText();
    }

    // Geen warmte achter tekst (elementen met data-no-heat, bv. de tekstkolom op de projectpagina's):
    // die stukken worden met een zachte rand weggeveegd
    const noHeat = Array.from(document.querySelectorAll<HTMLElement>('[data-no-heat]'));
    const FEATHER = 24;
    function maskText() {
      if (!noHeat.length) return;
      ctx.save();
      ctx.globalCompositeOperation = 'destination-out';
      ctx.fillStyle = '#000';
      ctx.shadowColor = '#000';
      ctx.shadowBlur = FEATHER * SCALE;
      // De rechthoek zelf ligt buiten beeld; enkel zijn vervaagde schaduw valt op de tekst
      const off = canvas!.width + 1000;
      ctx.shadowOffsetX = off;
      for (const el of noHeat) {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > innerHeight || !r.width) continue;
        const pad = 12;
        ctx.fillRect(
          (r.left - pad) * SCALE - off,
          (r.top - pad) * SCALE,
          (r.width + pad * 2) * SCALE,
          (r.height + pad * 2) * SCALE,
        );
      }
      ctx.restore();
    }

    function frame(now: number) {
      render(now);
      // Stoppen zodra alles verdwenen is: spaart batterij
      if (store.size) requestAnimationFrame(frame);
      else running = false;
    }

    function addData(x: number, y: number) {
      x = Math.round(x * SCALE);
      y = Math.round(y * SCALE);
      const key = y * 100000 + x;
      const now = performance.now();
      const p = store.get(key);
      if (p) {
        // Een plek die al vervaagde, telt weer mee met wat er nog van over was
        p.value = p.value * life(now - p.time) + 1;
        p.time = now;
      } else store.set(key, { x, y, value: 1, time: now });
      if (!running) {
        running = true;
        requestAnimationFrame(frame);
      }
    }

    function resize() {
      const w = Math.max(1, Math.round(innerWidth * SCALE));
      const h = Math.max(1, Math.round(innerHeight * SCALE));
      if (canvas!.width === w && canvas!.height === h) return;
      canvas!.width = shadow.width = w;
      canvas!.height = shadow.height = h;
      render(performance.now());
    }
    resize();
    addEventListener('resize', resize);

    addEventListener('pointermove', (e) => addData(e.clientX, e.clientY), { passive: true });
    addEventListener('pointerdown', (e) => addData(e.clientX, e.clientY), { passive: true });
    // Op gsm: ook tijdens het scrollen met je vinger
    addEventListener(
      'touchmove',
      (e) => {
        for (const t of Array.from(e.touches)) addData(t.clientX, t.clientY);
      },
      { passive: true },
    );
  }
</script>
