---
// Heatmap-achtergrond, nagebouwd naar de mousemove-demo van heatmap.js (patrick-wied.at/static/heatmapjs).
// Elke beweging van de muis of je vinger voegt een datapunt toe. Niets verdwijnt: de plek waar je het
// vaakst kwam is altijd het warmst, de rest kleurt in verhouding mee. Het canvas ligt achter alle inhoud,
// dus thumbnails, foto's en mockups blijven onaangeroerd.
---

<canvas class="heat" aria-hidden="true"></canvas>

<style>
  .heat {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  // Dezelfde instellingen als de demo van heatmap.js
  const RADIUS = 50;
  const BLUR = 0.9;
  const MAX_OPACITY = 0.6;
  const GRADIENT: [number, string][] = [
    [0.25, 'rgb(0,0,255)'],
    [0.55, 'rgb(0,255,0)'],
    [0.85, 'yellow'],
    [1, 'rgb(255,0,0)'],
  ];

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.heat');

  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    // Schaduwcanvas: hier wordt enkel de "warmte" (alfa) getekend, daarna ingekleurd
    const shadow = document.createElement('canvas');
    const sctx = shadow.getContext('2d', { willReadFrequently: true })!;

    // Palet van 256 kleuren
    const pal = document.createElement('canvas');
    pal.width = 256;
    pal.height = 1;
    const pctx = pal.getContext('2d')!;
    const grad = pctx.createLinearGradient(0, 0, 256, 1);
    for (const [stop, color] of GRADIENT) grad.addColorStop(stop, color);
    pctx.fillStyle = grad;
    pctx.fillRect(0, 0, 256, 1);
    const palette = pctx.getImageData(0, 0, 256, 1).data;

    // Eén punt: zachte cirkel, zoals heatmap.js die tekent
    const tpl = document.createElement('canvas');
    tpl.width = tpl.height = RADIUS * 2;
    const tctx = tpl.getContext('2d')!;
    const tg = tctx.createRadialGradient(RADIUS, RADIUS, RADIUS * (1 - BLUR), RADIUS, RADIUS, RADIUS);
    tg.addColorStop(0, 'rgba(0,0,0,1)');
    tg.addColorStop(1, 'rgba(0,0,0,0)');
    tctx.fillStyle = tg;
    tctx.fillRect(0, 0, RADIUS * 2, RADIUS * 2);

    // Datastore: aantal keer dat elke pixel geraakt werd
    const store = new Map<number, { x: number; y: number; value: number }>();
    let max = 1;

    function drawPoint(x: number, y: number, alpha: number) {
      sctx.globalAlpha = alpha < 0.01 ? 0.01 : alpha;
      sctx.drawImage(tpl, x - RADIUS, y - RADIUS);
    }

    // Warmte inkleuren met het palet, enkel binnen het gewijzigde stuk
    function colorize(x: number, y: number, w: number, h: number) {
      x = Math.max(0, Math.floor(x));
      y = Math.max(0, Math.floor(y));
      w = Math.min(shadow.width - x, Math.ceil(w));
      h = Math.min(shadow.height - y, Math.ceil(h));
      if (w <= 0 || h <= 0) return;
      const img = sctx.getImageData(x, y, w, h);
      const d = img.data;
      const maxA = MAX_OPACITY * 255;
      for (let i = 3; i < d.length; i += 4) {
        const a = d[i];
        if (!a) continue;
        const o = a * 4;
        d[i - 3] = palette[o];
        d[i - 2] = palette[o + 1];
        d[i - 1] = palette[o + 2];
        d[i] = a < maxA ? a : maxA;
      }
      ctx.putImageData(img, x, y);
    }

    // Alles opnieuw tekenen, nodig als het maximum stijgt (dan verschuiven alle kleuren)
    function renderAll() {
      sctx.clearRect(0, 0, shadow.width, shadow.height);
      ctx.clearRect(0, 0, canvas!.width, canvas!.height);
      for (const p of store.values()) drawPoint(p.x, p.y, Math.min(p.value, max) / max);
      colorize(0, 0, shadow.width, shadow.height);
    }

    function addData(x: number, y: number) {
      x = Math.round(x);
      y = Math.round(y);
      const key = y * 100000 + x;
      const p = store.get(key);
      const value = p ? ++p.value : 1;
      if (!p) store.set(key, { x, y, value });
      if (value > max) {
        max = value;
        renderAll();
      } else {
        drawPoint(x, y, 1 / max);
        colorize(x - RADIUS, y - RADIUS, RADIUS * 2, RADIUS * 2);
      }
    }

    function resize() {
      const w = innerWidth;
      const h = innerHeight;
      if (canvas!.width === w && canvas!.height === h) return;
      canvas!.width = shadow.width = w;
      canvas!.height = shadow.height = h;
      renderAll();
    }
    resize();
    addEventListener('resize', resize);

    addEventListener('pointermove', (e) => addData(e.clientX, e.clientY), { passive: true });
    addEventListener('pointerdown', (e) => addData(e.clientX, e.clientY), { passive: true });
    // Op gsm: ook tijdens het scrollen met je vinger
    addEventListener(
      'touchmove',
      (e) => {
        for (const t of Array.from(e.touches)) addData(t.clientX, t.clientY);
      },
      { passive: true },
    );
  }
</script>
