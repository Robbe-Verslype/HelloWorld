---
import { Image } from 'astro:assets';
import type { Block } from '../lib/designs';

// Tekst, tussentitels, foto's en video's van een case
interface Props {
  blocks: Block[];
}
const { blocks } = Astro.props;
---

{
  blocks.map((block) =>
    block.type === 'heading' ? (
      <h3>{block.text}</h3>
    ) : block.type === 'photo' ? (
      <Image src={block.photo.image} alt="" width={Math.min(1800, block.photo.image.width)} class="photo" />
    ) : block.type === 'video' ? (
      <div class:list={['video', { vertical: block.vertical, insta: block.kind !== 'video', post: block.kind === 'post' }]}>
        <iframe
          src={block.embed}
          title="Video"
          loading="lazy"
          allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
          allowfullscreen
        />
      </div>
    ) : (
      <p>
        {block.lines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </p>
    ),
  )
}

<style>
  .video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    background: #000;
  }
  /* Reels en andere staande video's: niet breder dan nodig */
  .video.vertical {
    aspect-ratio: 9 / 16;
    width: min(100%, 26rem);
    margin-inline: auto;
  }
  /* Instagram-embeds hebben een balk boven en onder de video */
  .video.insta {
    aspect-ratio: 400 / 860;
    width: min(100%, 24rem);
    margin-inline: auto;
    background: #fff;
  }
  .video.insta.post {
    aspect-ratio: 400 / 640;
  }
  .video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
