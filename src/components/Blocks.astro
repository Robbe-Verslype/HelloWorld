---
import { Image } from 'astro:assets';
import type { Block } from '../lib/designs';

// Tekst, tussentitels, foto's en video's van een case
interface Props {
  blocks: Block[];
}
const { blocks } = Astro.props;

// Video's die na elkaar staan, komen naast elkaar in één rij (zoals reels)
type Clip = Extract<Block, { type: 'clip' }>;
type Item = Block | { type: 'clips'; clips: Clip[] };
const items: Item[] = [];
for (const block of blocks) {
  const last = items.at(-1);
  if (block.type === 'clip') {
    if (last?.type === 'clips') last.clips.push(block);
    else items.push({ type: 'clips', clips: [block] });
  } else items.push(block);
}
---

{
  items.map((block) =>
    block.type === 'clips' ? (
      <div class="clips" style={`--cols: ${Math.min(block.clips.length, 3)}`}>
        {block.clips.map((clip) => (
          // #t=0.1 laat de browser het eerste beeld tonen vóór je op play drukt
          <video class="clip" src={`${clip.src}#t=0.1`} controls playsinline preload="metadata" />
        ))}
      </div>
    ) : block.type === 'heading' ? (
      <h3>{block.text}</h3>
    ) : block.type === 'photo' ? (
      <Image src={block.photo.image} alt="" width={Math.min(1800, block.photo.image.width)} class="photo" />
    ) : block.type === 'video' ? (
      <div class:list={['video', { vertical: block.vertical, insta: block.kind !== 'video', post: block.kind === 'post' }]}>
        <iframe
          src={block.embed}
          title="Video"
          loading="lazy"
          allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
          allowfullscreen
        />
      </div>
    ) : (
      <p>
        {block.lines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </p>
    ),
  )
}

<style>
  /* Eigen videobestanden: vullen de kolom, in hun eigen verhouding */
  .clips {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 0.75rem;
  }
  /* Op gsm: onder elkaar, net als de foto's */
  @media (max-width: 600px) {
    .clips {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
  .clip {
    display: block;
    width: 100%;
    height: auto;
    max-height: 85vh;
    border-radius: 4px;
    background: #000;
  }
  .video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    background: #000;
  }
  /* Reels en andere staande video's: niet breder dan nodig */
  .video.vertical {
    aspect-ratio: 9 / 16;
    width: min(100%, 26rem);
    margin-inline: auto;
  }
  /* Instagram-embeds hebben een balk boven en onder de video */
  .video.insta {
    aspect-ratio: 400 / 860;
    width: min(100%, 24rem);
    margin-inline: auto;
    background: #fff;
  }
  .video.insta.post {
    aspect-ratio: 400 / 640;
  }
  .video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
